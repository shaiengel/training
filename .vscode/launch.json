{
    "version": "0.2.0",
    "configurations": [        
        {
            "name": "Train Whisper",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train-whisper.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--output_model_name", "my-whisper-he",
                "--model_name", "openai/whisper-small",
                "--train_datasets", "C:/portal/dataset_builder/output/dataset[:24634]",
                "--eval_datasets", "C:/portal/dataset_builder/output/dataset[24634:]",
                "--target_language", "hebrew",
                "--skip_push_to_hub",
                "--use_qlora",
                "--per_device_train_batch_size", "1",
                "--gradient_accumulation_steps", "16"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Train Whisper (preprocessed)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train-whisper.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--output_model_name", "my-whisper-he",
                "--model_name", "ivrit-ai/whisper-large-v3",
                "--use_preprocessed", "portal-daf-yomi/portal-daf-yomi-whisper-training",
                "--target_language", "hebrew",
                "--skip_push_to_hub"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Train Whisper (HF Dataset Test)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train-whisper.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--output_model_name", "my-whisper-he-hf-test",
                "--model_name", "openai/whisper-small",
                "--use_preprocessed", "portal-daf-yomi/portal-daf-yomi-whisper-training",
                "--target_language", "hebrew",
                "--skip_push_to_hub",
                "--per_device_train_batch_size", "1",
                "--per_device_eval_batch_size", "1",
                "--gradient_accumulation_steps", "4",
                "--max_steps", "10",
                "--eval_steps", "5",
                "--logging_steps", "5",
                "--save_steps", "10",
                "--max_eval_set_size", "50",
                "--use_qlora"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Evaluate Google Speech",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evaluate_model.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--engine", "engines/google_speech_engine.py",
                "--model", "google-speech-api",
                "--dataset", "portal-daf-yomi/portal-daf-yomi-evaluation:train:transcript",
                "--device", "cpu"
            ],
            // "env": {
            //     "GOOGLE_APPLICATION_CREDENTIALS": ""
            // },
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
